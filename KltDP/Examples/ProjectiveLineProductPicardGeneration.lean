import KltDP.Examples.ProjectiveProductBoundaryCurves
import KltDP.Geometry.FactorialAffineDivisorEquation
import KltDP.Geometry.CartierPicardFiniteSupport
import KltDP.Geometry.CartierPicardComparison
import Mathlib.Tactic.Abel

/-!
# The original product Picard group is generated by its two ruling classes

Represent an original sheaf Picard class by a Cartier divisor. Its finite
Weil coordinates have an actual rational equation on the reciprocal plane
chart. Subtracting that principal Cartier divisor leaves only the two
original zero-fiber primes. Their previously proved classes are exactly
the named first and second fiber classes. No product Picard classification,
affine Picard triviality, or numerical identification is an input.
-/

noncomputable section

open AlgebraicGeometry

universe u

namespace KltDP.Examples.ProjectiveLineProductPicardGeneration

open KltDP.Geometry FrobeniusProjectivePoints FrobeniusStageZeroProjective
open FrobeniusGraphPicardClassFiberClasses FrobeniusGraphPicardClassIntegral
open FrobeniusGraphPicardClassMixedCoordinates FrobeniusRulingClassPairing
open ProjectiveProductFactorialChart ProjectiveProductBoundaryCurves

variable {k : Type u} [Field k] [IsAlgClosed k]

local instance productIntegral : IsIntegral (projectiveProduct k) :=
  projectiveProduct_isIntegral

local instance reciprocalSectionsUFD :
    UniqueFactorizationMonoid Γ((projectiveProductSurface (k := k)).toScheme,
      productOpen (k := k) 1 1) :=
  sections_uniqueFactorizationMonoid 1 1

/-- The homomorphism uses the two original ruling classes in the original Picard group. -/
def rulingClassHom : ℤ × ℤ →+ Additive (projectiveProduct k).Pic where
  toFun v := v.1 • firstFiberClass + v.2 • secondFiberClass
  map_zero' := by simp
  map_add' := by
    intro v w
    change (v.1 + w.1) • firstFiberClass + (v.2 + w.2) • secondFiberClass =
      (v.1 • firstFiberClass + v.2 • secondFiberClass) +
        (w.1 • firstFiberClass + w.2 • secondFiberClass)
    rw [add_zsmul, add_zsmul]
    abel

/-- Every actual sheaf Picard class of the original product comes from these two classes. -/
theorem rulingClassHom_surjective : Function.Surjective (rulingClassHom (k := k)) := by
  intro c
  obtain ⟨D, hD⟩ := cartierPicardHom_surjective (projectiveProduct k) c
  let f := (projectiveProductSurface (k := k)).affineRationalEquation
    (productOpen_isAffineOpen 1 1) ((projectiveProductSurface (k := k)).cartierToWeilHom D)
  let E := D - principalCartierDivisorHom (projectiveProduct k) (Additive.ofMul f)
  have hEclass : cartierPicardHom (projectiveProduct k) E =
      cartierPicardHom (projectiveProduct k) D := by
    simp only [E, map_sub, cartierPicardHom_principal, sub_zero]
  have hzero (C : (projectiveProductSurface (k := k)).PrimeCurve)
      (hC : C.genericPoint ∈ productOpen (k := k) 1 1) :
      (projectiveProductSurface (k := k)).cartierToWeilHom E C = 0 := by
    change ((projectiveProductSurface (k := k)).cartierToWeilHom
      (D - principalCartierDivisorHom (projectiveProduct k) (Additive.ofMul f))) C = 0
    have hp : (projectiveProductSurface (k := k)).cartierToWeilHom
        (principalCartierDivisorHom (projectiveProduct k) (Additive.ofMul f)) =
        (projectiveProductSurface (k := k)).principalDivisor f :=
      (projectiveProductSurface (k := k)).cartierToWeilHom_principal f
    rw [map_sub, hp]
    exact (projectiveProductSurface (k := k)).sub_principal_affineRationalEquation_apply
      (productOpen_isAffineOpen 1 1) ((projectiveProductSurface (k := k)).cartierToWeilHom D) C hC
  have hmem : cartierPicardHom (projectiveProduct k) E ∈
      (rulingClassHom (k := k)).range := by
    apply (projectiveProductSurface (k := k)).cartierPicardHom_mem_of_support
      baseRegular E (rulingClassHom (k := k)).range
    intro C hC
    have hnot : C.genericPoint ∉ productOpen (k := k) 1 1 :=
      fun h => hC (hzero C h)
    rcases eq_zeroFiber_of_genericPoint_not_mem C hnot with rfl | rfl
    · rw [verticalPrimeCurve_class]
      exact ⟨(1, 0), by simp [rulingClassHom]⟩
    · rw [horizontalPrimeCurve_class]
      exact ⟨(0, 1), by simp [rulingClassHom]⟩
  obtain ⟨v, hv⟩ := hmem
  exact ⟨v, hv.trans (hEclass.trans hD)⟩

/-- The exact integral generation statement for the manuscript's original two fiber classes. -/
theorem picardClass_eq_zsmul_fibers (c : Additive (projectiveProduct k).Pic) :
    ∃ x y : ℤ, c = x • firstFiberClass + y • secondFiberClass := by
  obtain ⟨⟨x, y⟩, h⟩ := rulingClassHom_surjective c
  exact ⟨x, y, h.symm⟩

end KltDP.Examples.ProjectiveLineProductPicardGeneration
