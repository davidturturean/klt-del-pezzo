import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.Algebra.Ring.NonZeroDivisors
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.LinearAlgebra.Dual.Defs

/-!
# The conormal module of a regular principal ideal

For an actual ideal `J` generated by a nonzerodivisor `d`, multiplication
by the class of `d` identifies the quotient ring `A/J` with Mathlib's
actual conormal module `J.Cotangent = J/J²`. The equivalence is linear
over the quotient ring from the start and retains the chosen generator.

There are no domain, local, Noetherian, or proper-ideal hypotheses. The
explicit singleton basis is local conormal data; no global line-bundle
gluing or normal-bundle degree is asserted here.
-/

noncomputable section

namespace KltDP.RingTheory

universe u

variable {A : Type u} [CommRing A] (J : Ideal A) (d : J)

/-- Multiplication by the actual conormal class of the chosen generator. -/
def principalConormalMap : (A ⧸ J) →ₗ[A ⧸ J] J.Cotangent :=
  LinearMap.toSpanSingleton (A ⧸ J) J.Cotangent (J.toCotangent d)

/-- The map has the canonical quotient-scalar multiplication formula. -/
@[simp]
theorem principalConormalMap_mk (r : A) :
    principalConormalMap J d (Ideal.Quotient.mk J r) = J.toCotangent (r • d) := rfl

/-- The unit is sent to the actual class of the generator. -/
@[simp]
theorem principalConormalMap_one : principalConormalMap J d 1 = J.toCotangent d :=
  LinearMap.toSpanSingleton_one (A ⧸ J) J.Cotangent (J.toCotangent d)

variable (hJ : Ideal.span {(d : A)} = J)

include hJ in
/-- A principal ideal's conormal module is generated by its defining equation. -/
theorem principalConormalMap_surjective :
    Function.Surjective (principalConormalMap J d) := by
  intro v
  obtain ⟨x, rfl⟩ := J.toCotangent_surjective v
  have hx : (x : A) ∈ Ideal.span {(d : A)} := hJ.symm ▸ x.property
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hx
  refine ⟨Ideal.Quotient.mk J r, ?_⟩
  rw [principalConormalMap_mk]
  apply congrArg J.toCotangent
  exact Subtype.ext hr

variable (hregular : (d : A) ∈ nonZeroDivisors A)

include hJ hregular in
/-- A regular generator has no further relation in the conormal module:
the annihilator of its class consists exactly of the defining ideal. -/
theorem principalConormalMap_injective :
    Function.Injective (principalConormalMap J d) := by
  rw [injective_iff_map_eq_zero]
  intro q hq
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [principalConormalMap_mk, Ideal.toCotangent_eq_zero] at hq
  change r * (d : A) ∈ J ^ 2 at hq
  have hpower : J ^ 2 = Ideal.span {(d : A)} * J :=
    (pow_two J).trans (congrArg (fun K : Ideal A => K * J) hJ.symm)
  obtain ⟨s, hs, hds⟩ := Ideal.mem_span_singleton_mul.mp (hpower ▸ hq)
  have hr : r = s :=
    (mul_cancel_left_mem_nonZeroDivisors hregular).mp (by
      calc
        (d : A) * r = r * (d : A) := mul_comm _ _
        _ = (d : A) * s := hds.symm)
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact hr.symm ▸ hs

/-- The actual quotient ring is canonically the conormal module after a
regular principal equation has been chosen. -/
def principalConormalEquiv : (A ⧸ J) ≃ₗ[A ⧸ J] J.Cotangent :=
  LinearEquiv.ofBijective (principalConormalMap J d)
    ⟨principalConormalMap_injective J d hJ hregular,
      principalConormalMap_surjective J d hJ⟩

/-- The equivalence preserves the normalized generator class. -/
@[simp]
theorem principalConormalEquiv_one :
    principalConormalEquiv J d hJ hregular 1 = J.toCotangent d :=
  principalConormalMap_one J d

/-- The equivalence has the exact expected formula on quotient representatives. -/
@[simp]
theorem principalConormalEquiv_mk (r : A) :
    principalConormalEquiv J d hJ hregular (Ideal.Quotient.mk J r) =
      J.toCotangent (r • d) := rfl

/-- An explicit singleton basis over the actual quotient ring. -/
def principalConormalBasis : Basis PUnit (A ⧸ J) J.Cotangent :=
  (Basis.singleton PUnit (A ⧸ J)).map (principalConormalEquiv J d hJ hregular)

/-- The unique basis vector is precisely the class of the regular equation. -/
@[simp]
theorem principalConormalBasis_apply (i : PUnit) :
    principalConormalBasis J d hJ hregular i = J.toCotangent d := by
  rw [principalConormalBasis, Basis.map_apply, Basis.singleton_apply,
    principalConormalEquiv_one]

/-- The dual conormal module is identified with the quotient ring by
evaluation on the chosen defining equation. This is local normal data. -/
def principalNormalEquiv : Module.Dual (A ⧸ J) J.Cotangent ≃ₗ[A ⧸ J] (A ⧸ J) :=
  (principalConormalEquiv J d hJ hregular).dualMap.trans
    (LinearMap.ringLmapEquivSelf (A ⧸ J) (A ⧸ J) (A ⧸ J))

/-- Normal coordinates evaluate the functional on the actual equation class. -/
@[simp]
theorem principalNormalEquiv_apply (ℓ : Module.Dual (A ⧸ J) J.Cotangent) :
    principalNormalEquiv J d hJ hregular ℓ = ℓ (J.toCotangent d) := by
  change ℓ (principalConormalEquiv J d hJ hregular 1) = _
  rw [principalConormalEquiv_one]

/-- Changing a generator by an actual scalar changes its conormal class
by the image of the same scalar in the quotient ring. -/
theorem toCotangent_eq_quotient_smul_of_eq_mul (e : J) (r : A)
    (he : (e : A) = r * (d : A)) :
    J.toCotangent e = Ideal.Quotient.mk J r • J.toCotangent d := by
  change J.toCotangent e = principalConormalMap J d (Ideal.Quotient.mk J r)
  rw [principalConormalMap_mk]
  exact congrArg J.toCotangent (Subtype.ext he)

end KltDP.RingTheory
