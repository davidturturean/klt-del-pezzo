import KltDP.Geometry.QuadraticRootQuotient
import KltDP.Geometry.QuadraticCoverAtlasIntersections
import KltDP.Geometry.QuadraticCoverEtale
import Mathlib.RingTheory.Ideal.Operations

/-!
# Actual branch and root ideals under quadratic atlas maps

The ideal generated by the original branch coefficient pulls back to the
square of the ideal generated by the actual quotient root. Unit changes
of that generator preserve its principal ideal. These statements are
then applied to the original coefficient maps of the actual affine atlas.
When two is invertible, the actual derivative ideal is the root ideal.

Reuse: pinned `Ideal.map_span`, `span_singleton_pow`, and
`span_singleton_mul_left_unit`; newer official Ideal/Operations.lean at
80cbd0498ab39e21d24d6730b3f932cec672a702 retains these principal-ideal
operations (Apache 2.0). No Cartier pullback along an arbitrary morphism
or regularity of an arbitrary branch section is presumed.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory Polynomial

universe u

namespace KltDP.Geometry.QuadraticCover

variable {R S : Type u} [CommRing R] [CommRing S]

/-- The pulled-back original branch ideal is exactly the square of the actual root ideal. -/
theorem map_branchIdeal_eq_rootIdeal_sq (s : R) :
    Ideal.map (algebraMap R (CoverAlgebra s)) (branchIdeal s) = rootIdeal s ^ 2 := by
  rw [branchIdeal, rootIdeal, Ideal.map_span, Set.image_singleton,
    Ideal.span_singleton_pow, root_sq]

/-- Unit generator rescaling preserves the actual principal branch ideal. -/
theorem map_branchIdeal_rescale (f : R →+* S) (s : R) (t : S) (v : Sˣ)
    (h : f s = (v : S) ^ 2 * t) :
    Ideal.map f (branchIdeal s) = branchIdeal t := by
  rw [branchIdeal, Ideal.map_span, Set.image_singleton, h]
  exact Ideal.span_singleton_mul_left_unit (v.isUnit.pow 2) t

/-- The actual coefficient/root map carries the source root ideal onto the target root ideal. -/
theorem map_rootIdeal_mappedRescaleHom (f : R →+* S) (s : R) (t : S) (v : Sˣ)
    (h : f s = (v : S) ^ 2 * t) :
    Ideal.map (mappedRescaleHom f s t v h) (rootIdeal s) = rootIdeal t := by
  rw [rootIdeal, Ideal.map_span, Set.image_singleton, mappedRescaleHom_root]
  exact Ideal.span_singleton_mul_left_unit
    (v.isUnit.map (algebraMap S (CoverAlgebra t))) (root t)

/-- The ideal of the actual evaluated Jacobian of the quadratic presentation. -/
def derivativeIdeal (s : R) : Ideal (CoverAlgebra s) :=
  Ideal.span {aeval (root s) (polynomial s).derivative}

/-- When two is invertible, its scalar factor does not change the Jacobian's root ideal. -/
theorem derivativeIdeal_eq_rootIdeal (s : R) (h2 : IsUnit (2 : R)) :
    derivativeIdeal s = rootIdeal s := by
  rw [derivativeIdeal, aeval_derivative_polynomial]
  exact Ideal.span_singleton_mul_left_unit
    (h2.map (algebraMap R (CoverAlgebra s))) (root s)

end KltDP.Geometry.QuadraticCover

namespace KltDP.Geometry.QuadraticCoverAtlas.Data

open TransitionUnitGluing QuadraticCover

variable {X : Scheme.{u}} {ι : Type u} (D : QuadraticCoverAtlas.Data X ι)

/-- The equation-ideal identity holds on every actual chart and every original subopen frame. -/
theorem frame_branchIdeal_eq_rootIdeal_sq {i : ι} {W : X.Opens}
    (hi : W ≤ D.opens i) :
    Ideal.map (algebraMap Γ(X, W) (CoverAlgebra (res X hi (D.sections i))))
        (branchIdeal (res X hi (D.sections i))) =
      rootIdeal (res X hi (D.sections i)) ^ 2 :=
  map_branchIdeal_eq_rootIdeal_sq _

/-- The coefficient ring map of the original actual scheme atlas map preserves the root ideal. -/
theorem map_frame_rootIdeal {i j : ι} {V W : X.Opens}
    (hi : V ≤ D.opens i) (hj : W ≤ D.opens j) (hWV : W ≤ V) :
    Ideal.map (Spec.preimage (D.map hi hj hWV)).hom
        (rootIdeal (res X hi (D.sections i))) =
      rootIdeal (res X hj (D.sections j)) := by
  simp only [map, localMap, mappedRescaleMap, Spec.preimage_map, CommRingCat.hom_ofHom]
  exact map_rootIdeal_mappedRescaleHom _ _ _ _ _

/-- The original base restriction likewise preserves the actual branch ideal between frames. -/
theorem map_frame_branchIdeal {i j : ι} {V W : X.Opens}
    (hi : V ≤ D.opens i) (hj : W ≤ D.opens j) (hWV : W ≤ V) :
    Ideal.map (res X hWV) (branchIdeal (res X hi (D.sections i))) =
      branchIdeal (res X hj (D.sections j)) := by
  apply map_branchIdeal_rescale (res X hWV) _ _
    (QuadraticTransitionCocycle.restrictedUnit X D.opens D.units (hWV.trans hi) hj)
  simpa only [res_res] using
    QuadraticTransitionCocycle.branchCondition_of_le
      X D.opens D.units D.sections D.branch (hWV.trans hi) hj

end KltDP.Geometry.QuadraticCoverAtlas.Data
