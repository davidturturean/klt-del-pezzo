import KltDP.Geometry.ReesChartLocalization
import Mathlib.Algebra.Ring.NonZeroDivisors

/-!
# The actual center ideal on a Rees chart

On the actual chart at `aT`, the extended ideal is generated by the image of
`a`, and that image is a nonzerodivisor. Inverting this chart equation gives
the original localization `R[1/a]`, with the canonical chart map as algebra
map. These statements require no domain or regularity hypothesis on `R`.

This is chart algebra toward the effective-Cartier and universal-property
statements for the Rees blowup. It does not assert global ideal-sheaf gluing,
scheme-level complement compatibility, or the full blowup universal property.
The proof reuses pinned localization constructors and the already proved
chart injection rather than introducing another affine blowup ring.
-/

noncomputable section

namespace KltDP.Geometry.AffineBlowup

variable {R : Type*} [CommRing R] (I : Ideal R) (a : I)

/-- The actual extended center ideal is principal on each Rees chart. -/
theorem map_chartBaseMap_ideal :
    Ideal.map (chartBaseMap I a) I = Ideal.span {chartBaseMap I a (a : R)} := by
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    intro r hr
    change chartBaseMap I a r ∈ Ideal.span {chartBaseMap I a (a : R)}
    apply Ideal.mem_span_singleton.mpr
    exact ⟨chartFraction I a ⟨r, hr⟩,
      (chartBaseMap_mul_chartFraction I a ⟨r, hr⟩).symm⟩
  · apply (Ideal.span_singleton_le_iff_mem (Ideal.map (chartBaseMap I a) I)).mpr
    exact Ideal.mem_map_of_mem (chartBaseMap I a) a.property

/-- The chart equation is a nonzerodivisor, even if the original `a` is a zero
divisor in the base ring. This follows from its unit image under the chart injection. -/
theorem chartBaseMap_equation_mem_nonZeroDivisors :
    chartBaseMap I a (a : R) ∈ nonZeroDivisors (chartRing I a) := by
  apply mem_nonZeroDivisors_of_injective (chartToLocalization_injective I a)
  rw [chartToLocalization_baseMap]
  exact (IsLocalization.Away.algebraMap_isUnit
    (S := Localization.Away (a : R)) (a : R)).mem_nonZeroDivisors

/-- The algebra structure on `R[1/a]` induced by the actual chart injection.
It is named explicitly to avoid installing an unrelated global instance. -/
def chartLocalizationAlgebra : Algebra (chartRing I a) (Localization.Away (a : R)) :=
  (chartToLocalization I a).toAlgebra

/-- The canonical chart map realizes `R[1/a]` as localization of the actual
Rees chart at its principal center equation. -/
theorem chartToLocalization_isLocalization :
    letI := chartLocalizationAlgebra I a
    IsLocalization.Away (chartBaseMap I a (a : R)) (Localization.Away (a : R)) := by
  letI := chartLocalizationAlgebra I a
  apply IsLocalization.Away.mk
  · change IsUnit (chartToLocalization I a (chartBaseMap I a (a : R)))
    rw [chartToLocalization_baseMap]
    exact IsLocalization.Away.algebraMap_isUnit (a : R)
  · intro z
    obtain ⟨n, r, hr⟩ := IsLocalization.Away.surj
      (S := Localization.Away (a : R)) (a : R) z
    refine ⟨n, chartBaseMap I a r, ?_⟩
    change z * chartToLocalization I a (chartBaseMap I a (a : R)) ^ n =
      chartToLocalization I a (chartBaseMap I a r)
    rw [chartToLocalization_baseMap, chartToLocalization_baseMap]
    exact hr
  · intro x y hxy
    change chartToLocalization I a x = chartToLocalization I a y at hxy
    exact ⟨0, by simpa only [pow_zero, one_mul] using
      chartToLocalization_injective I a hxy⟩

/-- Inverting the actual center equation on a Rees chart recovers `R[1/a]`. -/
def chartLocalizationEquiv :
    Localization.Away (chartBaseMap I a (a : R)) ≃+* Localization.Away (a : R) := by
  letI := chartLocalizationAlgebra I a
  letI : IsLocalization.Away (chartBaseMap I a (a : R)) (Localization.Away (a : R)) :=
    chartToLocalization_isLocalization I a
  exact (Localization.algEquiv (Submonoid.powers (chartBaseMap I a (a : R)))
    (Localization.Away (a : R))).toRingEquiv

/-- The localization equivalence retains exactly the previously constructed
canonical chart map, rather than an unspecified ring equivalence. -/
@[simp]
theorem chartLocalizationEquiv_algebraMap (x : chartRing I a) :
    chartLocalizationEquiv I a
      (algebraMap (chartRing I a) (Localization.Away (chartBaseMap I a (a : R))) x) =
        chartToLocalization I a x := by
  letI := chartLocalizationAlgebra I a
  letI : IsLocalization.Away (chartBaseMap I a (a : R)) (Localization.Away (a : R)) :=
    chartToLocalization_isLocalization I a
  exact (Localization.algEquiv (Submonoid.powers (chartBaseMap I a (a : R)))
    (Localization.Away (a : R))).commutes x

@[simp]
theorem chartLocalizationEquiv_baseMap (r : R) :
    chartLocalizationEquiv I a
      (algebraMap (chartRing I a) (Localization.Away (chartBaseMap I a (a : R)))
        (chartBaseMap I a r)) = algebraMap R (Localization.Away (a : R)) r := by
  rw [chartLocalizationEquiv_algebraMap, chartToLocalization_baseMap]

end KltDP.Geometry.AffineBlowup
